# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=1234567890:AAH_your_telegram_bot_token_here

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Groq Cloud API Key (console.groq.com) for Whisper ASR
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary & tiered Gemini models (swap names without code changes)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite
GEMINI_MODEL_SLOW_BACKUP=gemini-3.5-flash

# LLM Timeouts & Budgets (seconds)
LLM_TOTAL_BUDGET_SEC=45
LLM_TIMEOUT_FAST_SEC=8
LLM_TIMEOUT_SLOW_BACKUP_SEC=20
LLM_TIMEOUT_BATCH_SEC=30
LLM_TIMEOUT_BATCH_SLOW_SEC=45
LLM_TIMEOUT_HEAVY_SEC=60
LLM_TIMEOUT_OPENROUTER_SEC=20

# OpenRouter fallback configuration (optional, used only when all Gemini models fail)
OPENROUTER_API_KEY=
OPENROUTER_MODELS=inclusionai/ling-3.2-flash:free,particle-ai/particle-1:free
OPENROUTER_USE_FREE_ROUTER=true

# YouTube Proxy, Supadata & Gemini-URL Transcript Fallback settings
YT_PROXY_HTTP=
YT_PROXY_HTTPS=
YT_BLOCK_COOLDOWN_SEC=900
SUPADATA_API_KEY=
SUPADATA_MONTHLY_LIMIT=90
GEMINI_URL_TRANSCRIBE_ENABLED=true
GEMINI_URL_DAILY_LIMIT_SEC=25200
GEMINI_URL_WINDOW_SEC=300
GEMINI_URL_PARALLEL_WINDOWS=4

# Resource Safety & Concurrency Limits
WORK_DIR=/tmp/vsf_work
MAX_CONCURRENT_VIDEO_JOBS=1
MAX_CONCURRENT_GEMINI_URL_JOBS=1
MAX_CONCURRENT_TRANSLATION_JOBS=3
QUEUE_MAX_LENGTH=5
USER_HEAVY_JOBS_PER_HOUR=6
SOFTSUB_MAX_DURATION_SEC=1800
SOFTSUB_MAX_FILESIZE_MB=49
MIN_FREE_DISK_MB=1500

# Direct Streaming Links Server & Media settings (leave LINK_PUBLIC_BASE_URL empty to disable)
LINK_PUBLIC_BASE_URL=
LINK_BIND_HOST=0.0.0.0
LINK_BIND_PORT=8081
LINK_DIR=/var/tmp/vsf_links
LINK_TTL_SEC=21600
LINK_MAX_TOTAL_MB=4000
LINK_MAX_FILESIZE_MB=700
LINK_MAX_DURATION_SEC=7200
LINK_TRANSLATION_TIMEOUT_SEC=240
LINK_SIGNING_SECRET=
LINK_MAX_CONCURRENT_DOWNLOADS=3
LINK_RATE_LIMIT_PER_MIN=60

# Audio & matching parameters
WHISPER_MODEL=whisper-large-v3-turbo
AUDIO_CLIP_DURATION_SEC=40
CONFIDENCE_THRESHOLD=0.45

# Admin & privacy-preserving usage analytics
ADMIN_ID=123456789
ANALYTICS_SALT=replace_with_a_random_secret_salt_string
ANALYTICS_DB_PATH=data/analytics.db
